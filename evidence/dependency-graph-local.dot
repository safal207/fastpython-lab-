digraph AlexPyDependencies {
  rankdir=LR;
  label="Declared dependencies, last patch frontier";
  n0 [label="left_sum\nwindow_sum", style=filled, fillcolor="#e5e7eb"];
  n1 [label="left_sq\nwindow_squares", style=filled, fillcolor="#e5e7eb"];
